generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// إحصاءات مجهولة الهوية عند كل تصدير — بلا أي بيان عن الفقيد أو محتوى النعوة.
model ObituaryStat {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  ipHash     String?
  country    String?
  region     String?
  templateId String

  @@index([createdAt])
  @@index([templateId])
}

model Template {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  category  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}
